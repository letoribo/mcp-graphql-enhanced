{
	"name": "@letoribo/mcp-graphql-enhanced",
	"description": "Enhanced MCP server for GraphQL with dynamic headers and robust variables parsing — a drop-in replacement for mcp-graphql.",
	"keywords": [
		"mcp",
		"graphql",
		"llm",
		"claude-desktop",
		"enhanced",
		"tool-calling",
		"model-context-protocol",
		"federated-graphql"
	],
	"author": "letoribo",
	"license": "MIT",
	"repository": "github:letoribo/mcp-graphql-enhanced",
	"mcpName": "io.github.letoribo/mcp-graphql-enhanced",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"bin": {
		"mcp-graphql-enhanced": "dist/bin.js"
	},
	"files": [
		"dist",
		"smithery.yaml",
		"LICENSE",
		"README.md"
	],
	"engines": {
		"node": ">=22.15.0"
	},
	"scripts": {
		"dev": "tsx --watch src/bin.ts",
		"sync-version": "node scripts/sync-version.mjs",
		"build": "npm run sync-version && tsc && chmod +x dist/bin.js",
		"prepack": "npm run build",
		"start": "node dist/bin.js",
		"test": "tsx --test src/helpers/http-adapter.test.ts",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.27.1",
		"@whatwg-node/server": "^0.13.0",
		"graphql": "^16.11.0",
		"yargs": "17.7.2",
		"zod": "3.25.30",
		"zod-to-json-schema": "3.24.5"
	},
	"devDependencies": {
		"@graphql-tools/schema": "^10.0.23",
		"@types/node": "^24.7.2",
		"@types/yargs": "17.0.33",
		"prettier": "^3.6.2",
		"ts-node": "^10.9.2",
		"tsx": "^4.21.0",
		"typescript": "5.8.3"
	},
	"version": "4.15.3"
}
