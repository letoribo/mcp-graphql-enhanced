{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        
        "lib": ["ES2022", "DOM"],
        "types": ["node"],

        "outDir": "./dist",
        "rootDir": "./src",

        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,

        "noEmit": false,
        "declaration": true,
        "declarationMap": true,
        "noImplicitAny": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}